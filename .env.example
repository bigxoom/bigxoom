# ===== CENTRE PASTORAL NOTRE DAME DE FATIMA — ERP Environment =====
NODE_ENV=production

# Database
POSTGRES_USER=fatima
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=fatima_erp
DATABASE_URL=postgresql://fatima:change_this_strong_password@db:5432/fatima_erp

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Backend
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SOCKET_URL=http://localhost

# Currency
DEFAULT_CURRENCY=RWF

# Cloud backup (OPTIONAL — only used if internet is available)
CLOUD_BACKUP_ENABLED=false
CLOUD_BACKUP_ENDPOINT=
CLOUD_BACKUP_KEY=

# AI (OPTIONAL — local Ollama, never required for core ERP)
# To enable: set AI_ENABLED=true and run Ollama separately (docker run -d -p 11434:11434 ollama/ollama)
AI_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama2
